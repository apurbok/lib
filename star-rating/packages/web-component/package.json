{
  "name": "@libraries/linear-star-rating-element",
  "version": "0.1.0",
  "description": "Custom element <linear-star-rating> with linear decimal fills",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libraries/star-rating-core": "workspace:*"
  },
  "devDependencies": {
    "tslib": "^2.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
