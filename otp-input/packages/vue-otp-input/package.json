{
  "name": "@libraries/vue-otp-input",
  "version": "0.1.0",
  "description": "Accessible Vue 3 OTP input with paste and keyboard UX",
  "type": "module",
  "main": "./dist/vue-otp-input.umd.cjs",
  "module": "./dist/vue-otp-input.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-otp-input.es.js",
      "require": "./dist/vue-otp-input.umd.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@libraries/otp-input-core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "license": "MIT"
}
